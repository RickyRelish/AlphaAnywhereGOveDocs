            "setValueUnformattedProperties": "value.ID=convert_type(\"\",\"N\")\nvalue.CREATED=convert_type(eval(\"*if_error(Date(),\\\"\\\")\"),\"D\")\nvalue.CREATEDBY=convert_type(eval(\"*if_error(\\\"session.Username\\\",\\\"\\\")\"),\"C\")\nvalue.CATEGORY=convert_type(\"\",\"C\")\nvalue.SUBCATEGORY=convert_type(\"\",\"C\")\nvalue.REVIW_DATE=convert_type(\"\",\"D\")\nvalue.MONTHLY_INTERVAL=convert_type(\"0\",\"N\")\nvalue.PRIORITY=convert_type(\"Low\",\"C\")\nvalue.INTERNAL_EXTERNAL=convert_type(\"Internal\",\"C\")\nvalue.LOCATION=convert_type(eval(\"*if_error(\\\"session.location\\\",\\\"\\\")\"),\"C\")\nvalue.NOTES=convert_type(\"\",\"C\")\nvalue.ADDTIONAL_NOTES=convert_type(.f.,\"L\")\nvalue.ID1=convert_type(\"\",\"N\")\nvalue.ID_LINK=convert_type(\"\",\"N\")\nvalue.DATE_ENTERED=convert_type(eval(\"*if_error(Date(),\\\"\\\")\"),\"D\")\nvalue.ENTERED_BY=convert_type(eval(\"*if_error(\\\"session.Username\\\",\\\"\\\")\"),\"C\")\nvalue.STATUS=convert_type(\"Open\",\"C\")\nvalue.COMPLETED_DATE=convert_type(eval(\"*if_error(Date(),\\\"\\\")\"),\"D\")\nvalue.NOTES1=convert_type(\"\",\"C\")\nvalue.DELETED=convert_type(.f.,\"L\")\nvalue.DELETE=convert_type(.f.,\"L\")\n"
        },
