        "a_actionJavascript": [
            {
                "actionGuid": "ac14de67-6981-42fc-9db3-60e4386ea5f6",
                "scriptMetaData": "<a_ajs<[1]<display=\"{I:'$$window.toolbar.blank'}{F=Tahoma,10}{C=Dark Blue,White}{B=Blue White,Dark Blue}Message box - Transient{T=4}{I:'a5_vertical_line'}saved message\">\n<action=\"Message box - Transient\">\n<icon=\"$$window.toolbar.blank\">\n<isCommentedOut=.F.>\n<comment=\"saved message\">\n<builder=\"a5ajs_transientMessage(v,wf,pv,dlg_mode)\">\n<metaData=<<%str%\n<menujson=\"\">\n<variablename=\"\">\n<windownamevariable=\"\">\n<appearance=\"Google\">\n<html=\"Your record has been saved.\">\n<position=\"center\">\n<relativeElementJavascript=\"\">\n<className=\"\">\n<inlineStyle=\"\">\n<buttonsJSON=\"\">\n<showCloseButton=.T.>\n<closeButtonIcon=\"svgIcon=#alpha-icon-x:icon\">\n<verticaloffset=\"\">\n<horizontaloffset=\"\">\n<duration=5000>\n<animateshow=.T.>\n<showanimationtype=\"auto\">\n<showanimationduration=600>\n<animatehide=.T.>\n<hideanimationtype=\"auto\">\n<hideanimationduration=600>\n<messageHeight=\"<Default>\">\n%str%>\n<javascriptAttribute=<<%str%\nvar _html = '<div style=\"display:inline-block;\">Your record has been saved.</div>';\nvar _options = {\n\t\"className\": \"\",\n\t\"style\": \"box-shadow: 0px 2px 6px 2px rgba(0,0,0,.25);background: rgba(0,0,0,.8);color: #fff;border: 1px solid rgba(0,0,0,.8);border-radius: 4px;\",\n\t\"close\": {\n\t\t\"show\": true,\n\t\t\"icon\": \"svgIcon=#alpha-icon-x:icon{fill: #fff}\",\n\t\t\"iconHover\": \"svgIcon=#alpha-icon-xCircle:icon{fill: #fff}\"\n\t},\n\t\"duration\": 5000,\n\t\"animation\": {\n\t\t\"show\": {\n\t\t\t\"type\": \"auto\",\n\t\t\t\"duration\": 600\n\t\t},\n\t\t\"hide\": {\n\t\t\t\"type\": \"auto\",\n\t\t\t\"duration\": 600\n\t\t}\n\t}\n};\n{dialog.object}.transientMessage('center',_html,_options);%str%>\n<Javascriptdeclarations_row=\"\">\n<Javascriptdeclarations_global=\"\">\n<xbasicFunctions=\"\">\n>\n>\n<flagRunSynchronously=.F.>\n<flagWrapInTryCatch=.F.>\n<tryCatchJavascript=\"\">\n"
            }
