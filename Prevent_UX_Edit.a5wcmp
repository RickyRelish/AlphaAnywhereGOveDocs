 :old_Delete OR [Delete] IS NULL AND :old_Delete IS NULL)\n{Location}=(Location = :old_Location OR Location IS NULL AND :old_Location IS NULL)\n{Notes}=(Notes = :old_Notes OR Notes IS NULL AND :old_Notes IS NULL)\n{Additional_Notes}=(Additional_Notes = :old_Additional_Notes OR Additional_Notes IS NULL AND :old_Additional_Notes IS NULL)\n%str%>\n<primaryKeyFieldTypes=\"N\">\n<primaryKeyValueSource=\"<AutoIncrementValue>\">\n<primaryKeyFieldsNative=<<%str%\nID\n%str%>\n<tableNameNative=\"Maint_Prevention\">\n<sql<FieldArgInfo<[1]<varname=\"ID\">\n<fieldname=\"ID\">\n<updateable=.T.>\n<encrypted=\"F\">\n<encryptionKey=\"\">\n<datatype=\"N\">\n<nativeFieldName=\"ID\">\n<fieldInfo=\"N|T|T|Integer32|!!|ID\">\n<isObjectField=.F.>\n<indexIntoArray=5>\n<updateWhere=\"ID = :old_ID\">\n<sqlInsertSequence=\"\">\n<primaryKey=.T.>\n<fieldType=\"N\">\n<isFileUpload=.F.>\n<isImage=.F.>\n<isSignatureCapture=.F.>\n<argumentName=\":Maint_Prevention_ID\">\n<argumentNameForInsert=\":Maint_Prevention_ID\">\n<argumentName_New=\":New_ID\">\n<argumentName_Old=\":Old_ID\">\n<setField=\"ID = :Maint_Prevention_ID\">\n<setArgument=\"convert_type(e.dataSubmitted.ID,\\\"N\\\")\">\n<setArgument_New=\"convert_type(e.dataSubmitted.ID,\\\"N\\\")\">\n<setArgument_Old=\"convert_type(e.oldDataSubmitted.ID,\\\"N\\\")\">\n<autoIncrement=.T.>\n<xbset=\"sqlArgs.add(\\\"Maint_Prevention_ID\\\",convert_type(e.dataSubmitted.ID,\\\"N\\\"))\">\n>\n<[2]<varname=\"Created\">\n<fieldname=\"Created\">\n<updateable=.T.>\n<encrypted=\"F\">\n<encryptionKey=\"\">\n<datatype=\"D\">\n<nativeFieldName=\"Created\">\n<fieldInfo=\"D|F|T|Date|!!|Created\">\n<isObjectField=.F.>\n<indexIntoArray=7>\n<updateWhere=\"(Created = :old_Created OR Created IS NULL AND :old_Created IS NULL)\">\n<sqlInsertSequence=\"\">\n<primaryKey=.F.>\n<fieldType=\"D\">\n<isFileUpload=.F.>\n<isImage=.F.>\n<isSignatureCapture=.F.>\n<argumentName=\":Maint_Prevention_Created\">\n<argumentNameForInsert=\":Maint_Prevention_Created\">\n<argumentName_New=\":N