        "serverSideActionsArray": [
            {
                "name": "Populate_a_Dialog_with_data_from_one_or_more_tables",
                "xbasic": "\tdim flagRunPopulate as l = .t.\n\tdim e.tmpl.__specialMode as l = default .f.\n\tif e.tmpl.__specialMode = .T. then \n\t\tif e.tmpl.__specialModeType = \"newGridRow:\" then \n\t\t\tflagRunPopulate = .f.\n\t\tend if \n\tend if \n\tif flagRunPopulate then \n\t\t\n\ndim rtc as p\nrtc = e.rtc\n\nrtc.fatalError = .f.\ndim tmpl as p\ntmpl = e.tmpl\n\n\n\n\nif rtc.fatalError = .f. then \n\tdim jsErrorMessage as c = \"\"\n\tdim primaryKeyValue as c = \"\" +  \"ID\"\n\n\tif primaryKeyValue <> \"\" then \t\n\t\tdim count as n \n\t\tcount = w_count(primaryKeyValue,\"|||\")\n\t\tdim e.primaryKey[count] as c \n\t\tdim i as n \n\t\tfor i = 1 to count \n\t\t\te.primaryKey[i] = word(primaryKeyValue,i,\"|||\")\n\t\tnext i \n\tend if \nend if \n\nrtc.hasError = .f.\ndim jsPopulateControls as c = \"\"\ndim jsErrorMessage as c = \"\"\ndim jsDebuggingMessages as c = \"\"\n\nif rtc.fatalError = .f. then \n\t\n\n\trtc.hasError = .f.\n\tif primaryKeyValue <> \"\" then \n\t\tdim opx as p \n\t\topx.flagComputeWorkDoneHTML = .f.\n\t\topx.captureRawData = .f.\n\t\topx.dotvarNameForRawData = \"_data\"\t\n\t\topx.recordNotFoundErrorText = \"Record not found\"\n\t\tif opx.dotvarNameForRawData = \"\" then \n\t\t\topx.dotvarNameForRawData = \"_data\"\n\t\tend if \t\n\t\t\n\t\t\n\t\ta5DialogHelper_populateControlsFromTable(tmpl,e,rtc,100,opx,null_value())\n\n\t\tif rtc.fatalError = .f. .and. rtc.hasError = .f. then \n\t\t\tif opx.captureRawData = .t. then \n\t\t\t\teval(opx.dotvarNameForRawData) = eval(\"opx.\" + opx.dotvarNameForRawData)\n\t\t\tend if \n\t\tend if \n\telse\n\t\trtc.javascriptResponse = \"\"\n\t\trtc.workDoneHTML = \"\"\n\tend if \n\t\n\tif rtc.hasError = .f. .and. rtc.fatalError = .f. then \n\t\tjsPopulateControls = rtc.javascriptResponse\n\tend if \n\t\nend if \n\nif rtc.fatalError = .t. .or. rtc.hasError = .t. then \n\te.showGlobalError = .t.\n\tdim errorText as c \n\terrorText = rtc.errorText\n\tif rtc.fatalError = .t. then \n\t\terrorText = \"Populate Dialog from Tables Action did not run because of an error.\" + crlf() + errorText\n\tend if \n\terrorText = stritran(errorText,crlf(),\"<br>\")\n\tjsErrorMessage = \"var ele = $('\"+tmpl.alias+\".GLOBALERRORS')\" +crlf()+\\\n\t\"if(ele) $svs(ele,'\"+js_escape(errorText)+\"'); \" + crlf()+\\\n\t\"if(ele) ele.style.display = '';\"\n\t\n\t'Set back to .f. so that the dialog continue executing normally. The error will be reported on the Dialog screen.\n\trtc.fatalError  =  .f.\nelse\n\tjsErrorMessage = \"var ele = $('\"+tmpl.alias+\".GLOBALERRORS')\" +crlf()+\\\n\t\"if(ele) $svs(ele,'\"+js_escape(\"\")+\"'); \" + crlf()+\\\n\t\"if(ele) ele.style.display = 'none';\"\n\t\nend if \n\n\n\n\n\n\ndim e.javascript as c = default \"\"\ndim e.javascriptSystem as c = default \"\"\ne.javascriptSystem = \te.javascriptSystem  + \";\" + crlf()+\\\n\t\t\t\tjsPopulateControls  + crlf()+\\\n\t\t\t\tjsErrorMessage + crlf()+\\\n\t\t\t\tjsDebuggingMessages\n\n\nend if\n",
                "metadata": "<showDebuggingInformation=.F.>\n<getPrimaryKeyFrom=\"SpecifyNow\">\n<primaryKeyValue=\"ID\">\n<variableNameForPrimaryKey=\"\">\n<maximumNumberOfChildRecordsToRetrieve=100>\n<captureRawData=.F.>\n<dotvarname=\"_data\">\n<recordNotFoundMessage=\"Record not found\">\n",
                "builder": "populateDialogFromTable"
            },
            {
                "name": "Save_Submitted_Data_to_Table_s_",
                "xbasic": "dim flagUseTransactions as l \nflagUseTransactions = .f.\ndim rtc as p\ndim tmpl as p\ntmpl = e.tmpl\n\ndim serverSideEvents as p\n\n\n\ndim geography as p \nwith geography\nDIM geocodeFieldDefinition as C\nDIM locationFieldDefinition as C\n\nend with \n\ndim opx as p\nopx.serverSideEvents = serverSideEvents\nopx.geography = geography\nopx.afterSaveAction = \"Edit record just submitted\"\nopx.listControlsToRefresh = \"\"\n\n\n\n\na5DialogHelper_SaveData(tmpl, e, rtc,flagUseTransactions, opx)\n\ndim jsShowErrors as c = \"\"\ndim jsEnterNewRecord as c = \"\"\ndim jsToFireAfterSaveEvent as c = \"\"\ndim jsShowUpdateCommands as c = \"\"\n\ndim jsConfirmationMessage as c = \"\"\n\n\n\nif rtc.fatalError = .t. then \n\t'must set this flag to prevent the Dialog from clearing the error messages.\n\te.showGlobalError = .t.\n\tdim errorText as c \n\terrorText = rtc.errorText\n\t'errorText = stritran(errorText,crlf(),\"<br>\")\n\t\n\tjsShowErrors = \"{dialog.object}.showGlobalErrors('<Default>','\" + js_escape(errorText) + \"'); \" + crlf()\n\t\n\trtc.javascript.refreshAllControls = \"\"\n\trtc.javascript.setPrimaryKeyinStateObject = \"\"\n\trtc.javascript.prepareDialog = \"\"\n\tjsToFireAfterSaveEvent = \"\"\n\tjsEnterNewRecord = \"\"\n\t\n\t\nend if \n\n\nif rtc.flagRecordWasSaved then \n\tjsConfirmationMessage = <<%js%\n{dialog.object}.fadeOutMessage('{dialog.componentname}.V.R1.PLACEHOLDER_1','Record was saved',2000,true);\n%js%\n\nelse\n\tjsEnterNewRecord = \"\"\nend if \n\n\n\n\n\n\n\ndim rtc.javascript.refreshAllControls as c = default \"\"\ndim rtc.javascript.prepareDialog as c = default \"\"\n'This flag must be set to .t., else the Javascript that sets the primaryKey in the state object will be overwritten.\ne.rtc.flagUpdatePrimaryKeysInStateObject = .t.\ndim rtc.javascript.setPrimaryKeyinStateObject as c = default \"\"\ndim e.javascript as c = default \"\"\n\ndim rtc.javascript.refreshDependentListControls as c = default \"\"\t\n\nif rtc.flagRecordWasSaved then\n\tjsToFireAfterSaveEvent = jsToFireAfterSaveEvent + <<%longtxt%\n\t\t(function() {{dialog.object}.runAction('Message');; if({dialog.object}._functions._setInkControlsBackground) {{dialog.object}._functions._setInkControlsBackground(); ; };\n })();\n\t%longtxt%\nend if \n\n\n \n\ne.javascript = \trtc.javascript.refreshDependentListControls + \";\" + crlf()+\\\n\t\t\t\te.javascript + \";\" + crlf()  +\\\n\t\t\t\tjsShowUpdateCommands + crlf() +\\\n\t\t\t\tjsShowErrors + crlf()+\\\n                rtc.javascript.refreshAllControls + crlf() +\\\n\t\t\t\trtc.javascript.setPrimaryKeyinStateObject + crlf()+\\\n\t\t\t\trtc.javascript.prepareDialog + crlf() +\\\n\t\t\t\tjsToFireAfterSaveEvent + crlf()+\\\n\t\t\t\tjsEnterNewRecord + crlf()+\\\n\t\t\t\tjsConfirmationMessage\n\n'set the e.javascriptsystem variable so that in case the user sets e.javascript in their own code, that this value does not get lost\ne.javascriptSystem = e.javascript\t\ne.javascript = \"\"\t\t\t\n\ne.setPrimaryKeyinStateObject = rtc.javascript.setPrimaryKeyinStateObject\t\t\t\t\n\t\t\t\t\n",
                "metadata": "<afterSubmitAction=\"Edit record just submitted\">\n<targetPage=\"\">\n<displayDebuggingInfo=.F.>\n<clientSideAfterSave=\"\">\n<useTransactions=.F.>\n<clientSideArguments=\"\">\n<clientSideAfterSaveSuccessJavascript=\"{dialog.object}.runAction('Message');\">\n<clientSideAfterSaveFailedJavascript=\"\">\n<clientSideAfterSaveSuccessPanelToActivate=\"\">\n<displayFadeOutMessage=.T.>\n<fadeOutMessage=\"Record was saved\">\n<fadeOutMessagePosition=\"PLACEHOLDER_1\">\n<fadeOutMessageDuration=\"2000\">\n<fadeOutMessageStyle=\"Default\">\n<flagsynchronizeListControls=.F.>\n<listControlsToSynchronize=\"\">\n<globalErrorsPlaceholder=\"<Default>\">\n<debuggingInformationPlaceholder=\"<Default>\">\n<flagStoreLocationInformation=.F.>\n<flagStoreLocationInformationC=\"No\">\n<latField=\"\">\n<lngField=\"\">\n<flagUpdateLocationField=.F.>\n<locationFieldNameForLatLng=\"\">\n<storeLocationWhen=\"InsertAndUpdate\">\n<serverSideEvent<beforeRecordInsert=\"\">\n<afterRecordInsert=\"\">\n<beforeRecordUpdate=\"\">\n<afterRecordUpdate=\"\">\n<beforeRecordDelete=\"\">\n<afterRecordDelete=\"\">\n<afterSectionRowRefresh=\"\">\n<onSQLError=\"\">\n>\n<geography<geocodeFieldDefinition=\"\">\n<locationFieldDefinition=\"\">\n>\n",
                "builder": "saveDataToTables"
            },
            {
                "name": "Load_Primary_keys_for_Parent_Table",
                "xbasic": "\nif eval_valid(\"e.tmpl.databinding.tabletype\") = .f. then \n\texit function \nend if \nif e.tmpl.databinding.tabletype <> \"SQL\" then \n\te.showGlobalError = .t.\n\tdim errorText as c \n\terrorText = \"The Data Binding table type for this Component appears to have been changed from SQL to DBF. The code in your server side action scripts needs to be re-generated. Please edit your server-side actions (in the onDialogInitialize, afterDialogValidate, etc. events) and then resave them to re-generate the code. \"\n\terrorText = stritran(errorText,crlf(),\"<br>\")\n\tjsErrorMessage = \"var ele = $('\"+e.tmpl.alias+\".GLOBALERRORS')\" +crlf()+\\\n\t\"if(ele) $svs(ele,'\"+js_escape(errorText)+\"'); \" + crlf()+\\\n\t\"if(ele) ele.style.display = '';\"\n\te.javascript = jsErrorMessage\n\texit function \nend if \n\n\ndim primaryKeyTemplate as c \nprimaryKeyTemplate = \"\"\n\n\n\nrtc.fatalError = .f.\ndim javascriptSetPrimaryKeys as c = \"\"\ndim tmpl as p\ntmpl = e.tmpl\ndim cn as sql::connection \ndim flag as l \ndim connstring as c \ndim args as sql::arguments \n\nconnstring = tmpl.databinding.connectionstring\nif variable_exists(\"session\") = .f. then \n\tflag = cn_open(cn,connstring)\nelse\n\tflag = a5SQLConnectionOpen(cn,connstring,session)\nend if \nif flag = .f. then \n\trtc.fatalError = .t.\n\trtc.errorText = \"Could not connect to database. Error reported was: \" + cn.CallResult.text \nend if \n\nif rtc.fatalError = .f. then \n\t\n\tdim sqlNoLimit as c \n\tsqlNoLimit = \"SELECT ID AS k FROM Maint_Prevention Maint_Prevention\"\n\t\n\tdim flagOracle as l = .f.\n\tif cn.CurrentSyntax = \"oracle\" then \n\t\tflagOracle = .t.\n\tend if \n\t\n\t\n\t\n\tif flagOracle then \n\t\tsqlNoLimit = stritran(sqlNoLimit,\"OracleLower(\",\"lower(\")\n\t\tsqlNoLimit = stritran(sqlNoLimit,\"OracleRtrim(\",\"rtrim(\")\n\telse\n\t\tsqlNoLimit = stritran(sqlNoLimit,\"OracleLower(\",\"\")\n\t\tsqlNoLimit = stritran(sqlNoLimit,\"OracleRtrim(\",\"\")\n\tend if \n\n\t\n\t\n\tif atc(\"session.\",sqlNoLimit) > 0 then \n\t\tif eval_valid(\"session\") then \n\t\t\tsqlNoLimit = replace_variables_in_string(sqlNoLimit,session,\"session\",.t.,.t.)\n\t\tend if  \n\tend if \n\t\n\t\n\t\n\tdim sql as c \n\tsql = \"SELECT FIRST 1000 ID AS k FROM Maint_Prevention Maint_Prevention\"\n\t\n\tif flagOracle then \n\t\tsql = stritran(sql,\"OracleLower(\",\"lower(\")\n\t\tsql = stritran(sql,\"OracleRtrim(\",\"rtrim(\")\n\telse\n\t\tsql = stritran(sql,\"OracleLower(\",\"\")\n\t\tsql = stritran(sql,\"OracleRtrim(\",\"\")\n\tend if \n\n\t\n\t\n\tif atc(\"session.\",sql) > 0 then \n\t\tif eval_valid(\"session\") then \n\t\t\tsql = replace_variables_in_string(sql,session,\"session\",.t.,.t.)\n\t\tend if  \n\tend if \n\t\n\t\n\tcn.PortableSQLEnabled = .t.\n\tdim args as sql::arguments \n\tif eval_valid(\"e.arguments\") then \n\t\targs = e.arguments\n\tend if \n\t\n\tdim pc as p\n\t\n\tpc = a5_sql_getcount(cn,sqlNoLimit,args)\t\n\n\tif pc.error = .t. then \n\t\trtc.fatalError = .t.\n\t\trtc.errorText = \"Error getting count of records in query.\"\n\t\tcn.close()\n\tend if \n\t\n\t'if pc.count = -1 then could not get count of records in query\n\tif pc.count = -1 then \n\t\tcn.close()\n\tend if \n\trtc.recordsInQuery = pc.count \n\t\n\t\n\t\n\tif rtc.fatalError = .f. then \n\t\tflag = cn.Execute(sql,args)\n\t\tif flag = .f. then \n\t\t\trtc.fatalError = .t.\n\t\t\trtc.errorText = \"Could not execute query to get keys. Error reported was: \" + cn.CallResult.text \n\t\t\tcn.close()\n\t\tend if \n\tend if \nend if \n\ndim flagFatalError as l = .t.\nif rtc.fatalError = .f. then \n\tif pc.count > -1 then \n\t\tflagFatalError = .f.\n\tend if \nend if \n\nif flagFatalError = .f. then \n\tdim rs as sql::ResultSet\n\trs = cn.ResultSet\n\tdim txt_JSONKeys as c \n\tif primaryKeyTemplate = \"\" then \n\t\ttxt_JSONKeys = rs.ToJSONObjectSyntax()\n\telse\n\t\ttxt_JSONKeys = a5_mergeDataIntoTemplate(primaryKeyTemplate,rs)\n\tend if \n\ttxt_JSONKeys = \"[\" + crlf_to_comma(txt_JSONKeys) + \"]\"\n\t'make sure {k is lower case - some databases, such as Oracle will generate upper case names by default\n\ttxt_JSONKeys = stritran(txt_JSONKeys,\"{K\",\"{k\")\n\ttxt_JSONKeys = stritran(txt_JSONKeys,\"{\\\"K\",\"{\\\"k\")\n\t\n\t\n\t\tdim sliderCode as c = \"\"\n\tdim listViewCode as c = \"\"\n\t\n\tsliderCode = <<%txt%\n\n\t%txt%\n\n\t\n\tlistViewCode = <<%txt%\n\n\t%txt%\n\t\n\tjavascriptSetPrimaryKeys = \"{dialog.object}._primaryKeyList = \" + txt_JSONKeys  + \";\"\n\tjavascriptSetPrimaryKeys = javascriptSetPrimaryKeys + sliderCode + crlf()\n\tjavascriptSetPrimaryKeys = javascriptSetPrimaryKeys + \"{dialog.object}._navigationSliderSetMax('FullyQualified',{dialog.object}._primaryKeyList.length);\"\n\tjavascriptSetPrimaryKeys = javascriptSetPrimaryKeys + listViewCode + crlf()\n\tjavascriptSetPrimaryKeys = javascriptSetPrimaryKeys + \"if({dialog.object}._primaryKeyListNavigator) { var lObj = {dialog.object}._primaryKeyListNavigator; var data = {dialog.object}._primaryKeyList ; lObj.populate(data); if(data.length > 0) lObj.setValue(0,false); }\" + crlf()\n\t\n\t\n\tdim filter as c\n\tdim order as c \n\tdim maxNumberOfkeys as n \n\tfilter = \"\"\n\torder = \"\"\n\tmaxNumberOfKeys = \"1000\"\n\tdim pjs as p \n\tpjs.__keys_Filter = filter\n\tpjs.__keys_Order = order\n\t'pjs.__keys_FilterArguments = args.XML\n\tpjs.__keys_FilterArgumentsJSON = argumentsToJSON(args,.t.)\n\tpjs.__keys_MaxKeys = \"\" + maxNumberOfKeys\n\tdim jsState as c \n\tjsState = vartojson(pjs,.f.,.t.)\n\tjsState = tmpl.alias  + \"_DlgObj.setStateInfo(\" + jsState + \");\" + \"//ssi-50;\" + crlf()\n\tjavascriptSetPrimaryKeys = javascriptSetPrimaryKeys + jsState\n\n\tif rtc.recordsInQuery > 0 then\n\t\t'--------------------------------------\n\t\t'get the javascript now to populate the controls for the first record - don't do another callback\n\t\tdim pp as p \n\t\tif txt_JSONKeys <> \"\" then\n\t\t\tpp = json_parse(txt_JSONKeys)\n\t\t\tdim keyFirst as c \n\t\t\tkeyFirst = pp[1].k\n\t\t\tdim ops as p\n\t\t\tops.primaryKey = keyFirst\n\t\t\tops.showDebugInfo = .f.\n\t\t\tdim js_getRecord as c \n\t\t\tdim eTemp as p\n\t\t\teTemp.tmpl = tmpl\n\t\t\t\n\t\t\t\n\t\t\t\n\t\t\tif eval_valid(\"e.rtc._state.__dtfmt\") then\n\t\t\t\tops.__dtfmt = e.rtc._state.__dtfmt\n\t\t\telse if eval_valid(\"rtc._state.__dtfmt\") then \n\t\t\t\tops.__dtfmt = rtc._state.__dtfmt\n\t\t\telse if eval_valid(\"request.variables._state.__dtfmt\") then \n\t\t\t\tops.__dtfmt = request.variables._state.__dtfmt\n\t\t\tend if \n\t\t\t\n\t\t\t\n\t\t\tjs_getRecord = a5_UX_Action(eTemp,ops,\"populateControlsFromTable\")\n\t\t\te._argsXML = ops.args.xml 'this is so that if you have a data bound ux and an argument that is bound to a databound field, the argument can be properly initialized\n\t\t\t\n\t\t\tjs_getRecord = js_getRecord + \";\" + crlf() + \"{dialog.object}._currentRecordNumber = 1;\"\n\t\t\t\n\t\t\tdim e.javascriptEmitAtEnd as c = default \"\"\n\t\t\tif e.javascriptEmitAtEnd <> \"\" then \n\t\t\t\te.javascriptEmitAtEnd = alltrim(e.javascriptEmitAtEnd) + \";\"\n\t\t\tend if \n\t\t\te.javascriptEmitAtEnd = e.javascriptEmitAtEnd + crlf() +js_getRecord\n\t\t\t\n\n\t\telse\n\t\t\tjs_getRecord = \"{dialog.object}.navigateRecord('first');\"\n\t\tend if \n\t\t\n\t\t\n\t\t'----------------------------------------------------\n\t\tjavascriptSetPrimaryKeys = javascriptSetPrimaryKeys + js_getRecord\n\t\tjavascriptSetPrimaryKeys = javascriptSetPrimaryKeys + <<%txt%\n\t\t\n\t\t%txt%\n\telse\n\t\n\t\n\t\t'-\n\t\t'----------------new record javascript -------------\n\t\tdim ops as p\n\t\tops.showDebugInfo = .f.\n\t\tdim js_getNewRecord as c \n\t\tdim eTemp as p\n\t\tops.arguments = e.arguments \n\t\teTemp.tmpl = tmpl\n\t\tif eval_valid(\"e.rtc._state.__dtfmt\") then\n\t\t\tops.__dtfmt = e.rtc._state.__dtfmt\n\t\telse if eval_valid(\"rtc._state.__dtfmt\") then \n\t\t\tops.__dtfmt = rtc._state.__dtfmt\n\t\telse if eval_valid(\"request.variables._state.__dtfmt\") then \n\t\t\tops.__dtfmt = request.variables._state.__dtfmt\n\t\tend if \n\t\t'get the javascript for the new record now, rather than making another callback\n\t\tjs_getNewRecord = a5_UX_Action(eTemp,ops,\"newrecord\")\n\t\tjavascriptSetPrimaryKeys = javascriptSetPrimaryKeys + js_getNewRecord\n\t\t'------------------------------------------------------\n\n\t\t'javascriptSetPrimaryKeys = javascriptSetPrimaryKeys + \"{Dialog.Object}.newRecord();\"\n\tend if \n\n\n\t\n\t\n\tcn.close()\nend if \n\nif rtc.fatalError = .t. then \n\te.showGlobalError = .t.\n\tdim errorText as c \n\terrorText = rtc.errorText\n\terrorText = stritran(errorText,crlf(),\"<br>\")\n\tjsErrorMessage = \"var ele = $('\"+tmpl.alias+\".GLOBALERRORS')\" +crlf()+\\\n\t\"if(ele) $svs(ele,'\"+js_escape(errorText)+\"'); \" + crlf()+\\\n\t\"if(ele) ele.style.display = '';\"\nelse\n\tjsErrorMessage = \"var ele = $('\"+tmpl.alias+\".GLOBALERRORS')\" +crlf()+\\\n\t\"if(ele) $svs(ele,'\"+js_escape(\"\")+\"'); \" + crlf()+\\\n\t\"if(ele) ele.style.display = 'none';\"\n\t\nend if \n\n\n\n\ndim e.javascript as c = default \"\"\ndim e.javascriptSystem as c = default \"\"\ne.javascriptSystem = \te.javascriptSystem  + \";\" + crlf()+\\\n\t\t\t\tjavascriptSetPrimaryKeys  + crlf()+\\\n\t\t\t\tjsErrorMessage\n\t\t\t\t\ndim e.javascriptEmitAtEnd as c = default \"\"\n\ndim js_getRecord as c = default \"\"\ndim js_getNewRecord as c = default \"\"\ne.javascriptEmitAtEnd = js_getRecord + js_getNewRecord\n\ndim tmpl.embeddedMode as l = default .f.\nif tmpl.embeddedMode then \n\te.javascriptSystem = a5GridHelper_FixWorkingPreview_EmbeddedIcons(e.javascriptSystem)\t\t\t\t\nend if \n\t\t\t\t\n\t\t\t\t\n",
