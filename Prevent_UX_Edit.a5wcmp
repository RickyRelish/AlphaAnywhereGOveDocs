            "precalc": {
                "flagCodeComputed": true,
                "code": "<[1]<sectionName=\"<Top Level>\">\n<_aliasesAtThisLevel=<<%str%\nMaint_Prevention\n%str%>\n<maxRowsToDisplay=1>\n<cascadingDropdownsInSection=\"\">\n<alias<[1]<aliasName=\"Maint_Prevention\">\n<tableInfoForAlias=<<%str%\nID=N|T|T|Integer32|!!|ID\nCreated=D|F|T|Date|!!|Created\nCreatedBy=C|F|T|VaryingCharacter|!!|CreatedBy\nCategory=C|F|T|VaryingCharacter|!!|Category\nSubCategory=C|F|T|VaryingCharacter|!!|SubCategory\nReviw_Date=D|F|T|Date|!!|Reviw_Date\nMonthly_Interval=N|F|T|Number|!!|Monthly_Interval\nPriority=C|F|T|VaryingCharacter|!!|Priority\nInternal_External=C|F|T|VaryingCharacter|!!|Internal_External\nDelete=L|F|T|Boolean|!!|[Delete]\nLocation=C|F|T|VaryingCharacter|!!|Location\nNotes=C|F|F|VaryingCharacter|!!|Notes\nAdditional_Notes=L|F|T|Boolean|!!|Additional_Notes\n%str%>\n<tableName=\"Maint_Prevention\">\n<variablesAndCorrespondingFieldNameForAlias=<<%str%\nID|ID|T|F||N\nCreated|Created|T|F||D\nCreatedBy|CreatedBy|T|F||C\nCategory|Category|T|F||C\nSubCategory|SubCategory|T|F||C\nReviw_Date|Reviw_Date|T|F||D\nMonthly_Interval|Monthly_Interval|T|F||N\nPriority|Priority|T|F||C\nInternal_External|Internal_External|T|F||C\nLocation|Location|T|F||C\nNotes|Notes|T|F||C\nAddtional_Notes|Additional_Notes|T|F||L\nDelete|Delete|T|F||L\n%str%>\n<variablesAndCorrespondingEncryptionInfo=<<%str%\nID=F|\nCreated=F|\nCreatedBy=F|\nCategory=F|\nSubCategory=F|\nReviw_Date=F|\nMonthly_Interval=F|\nPriority=F|\nInternal_External=F|\nLocation=F|\nNotes=F|\nAddtional_Notes=F|\nDelete=F|\n%str%>\n<variableAndCorrespondingFieldArrayIndex=<<%str%\nID|5\nCreated|7\nCreatedBy|8\nCategory|9\nSubCategory|10\nReviw_Date|11\nMonthly_Interval|12\nPriority|13\nInternal_External|14\nLocation|15\nNotes|16\nAddtional_Notes|18\nDelete|40\n%str%>\n<indexIntoTableArray=1>\n<parentLinkFields=\"\">\n<parentLinkVariables=\"\">\n<linkFields=\"\">\n<linkFieldsForDownstreamLinks=\"\">\n<tableType=\"SQL\">\n<parent=\"\">\n<readOnly=.F.>\n<sqlInsertSequence=\"\">\n<SQL_SecondP